# ---- NoneBot2 ----
DRIVER=~fastapi+~websockets
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
SUPERUSERS=["你的QQ号"]

# ---- wm-helper ----
WM_PLATFORM=pc
WM_LANGUAGE=zh-hans
WM_CROSSPLAY=false
# 服务器无海外出口时填写，例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
WM_PROXY=

# 无海外出口时也可走国内云函数中转（见 deploy/cloudfunc/README.md）
# 填了 WM_BASE_URL 就优先走中转，WM_PROXY 可留空
# WM_BASE_URL=https://service-xxxxxx.gz.apigw.tencentcs.com/release/v2
# WM_TOKEN=与云函数环境变量一致
WM_USER_AGENT=wm-helper/0.1.0 (+https://github.com/yourname/wm-helper)
WM_CACHE_DIR=/app/.cache
